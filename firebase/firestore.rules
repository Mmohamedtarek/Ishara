rules_version = '2';

// Ishara (step 10b). Phase 0 data model; every path is the signed-in user's
// own (request.auth.uid == uid) and everything else is denied. Writes need a
// verified email (Q-B3). Field types, sizes and allowed values are checked.
// activity documents can be created and deleted by their owner, never
// changed (Phase 0 said create-only; delete is needed for account deletion
// on the Spark plan, Q-B1).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function canWrite(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function data() {
      return request.resource.data;
    }

    // exactly the keys in [required], plus any of [optional]
    function keysAre(required, optional) {
      return data().keys().hasAll(required)
        && data().keys().hasOnly(required.concat(optional));
    }

    function isText(v, max) {
      return v is string && v.size() >= 1 && v.size() <= max;
    }

    function optText(key, max) {
      return !(key in data()) || isText(data()[key], max);
    }

    function optBool(key) {
      return !(key in data()) || data()[key] is bool;
    }

    function optIn(key, values) {
      return !(key in data()) || data()[key] in values;
    }

    // users/{uid}: the profile
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if canWrite(uid)
        && keysAre(['displayName', 'createdAt', 'updatedAt', 'schemaVersion'], [])
        && data().displayName is string && data().displayName.size() <= 100
        && data().createdAt is timestamp
        && data().updatedAt is timestamp
        && data().schemaVersion == 1;
      allow delete: if canWrite(uid);

      // users/{uid}/settings/app: one document, last writer wins
      match /settings/{doc} {
        allow read: if isOwner(uid);
        allow create, update: if canWrite(uid) && doc == 'app'
          && keysAre(['updatedAt'], ['uiLang', 'theme', 'signLanguage',
              'spokenLanguage', 'who', 'avatarId', 'signSpeed', 'subtitles',
              'bigText', 'highContrast', 'vibrate'])
          && data().updatedAt is timestamp
          && optIn('uiLang', ['en', 'ar'])
          && optIn('theme', ['system', 'light', 'dark'])
          && optIn('signLanguage', ['asl'])
          && optIn('spokenLanguage', ['en', 'ar'])
          && optIn('who', ['sign', 'speak'])
          && optText('avatarId', 40)
          && optIn('signSpeed', [0.5, 1, 1.5])
          && optBool('subtitles') && optBool('bigText')
          && optBool('highContrast') && optBool('vibrate');
        allow delete: if canWrite(uid);
      }

      // users/{uid}/phrases/{phraseId}: starred sentences, tombstones kept
      match /phrases/{phraseId} {
        allow read: if isOwner(uid);
        allow create, update: if canWrite(uid)
          && phraseId.matches('^[0-9a-f]{1,64}$')
          && keysAre(['text', 'lang', 'createdAt', 'updatedAt', 'deleted'], [])
          && isText(data().text, 500)
          && data().lang in ['en', 'ar']
          && data().createdAt is timestamp
          && data().updatedAt is timestamp
          && data().updatedAt >= data().createdAt
          && data().deleted is bool;
        allow delete: if canWrite(uid);
      }

      // users/{uid}/activity/{eventId}: Learn's append-only log
      match /activity/{eventId} {
        allow read: if isOwner(uid);
        allow create: if canWrite(uid)
          && eventId.matches('^[A-Za-z0-9_:-]{1,64}$')
          && keysAre(['v', 'type', 'moduleId', 'passed', 'xp', 'day', 'at',
              'deviceId'], ['label', 'prob'])
          && data().v == 1
          && data().type in ['quiz', 'practice', 'missionDone']
          && isText(data().moduleId, 40)
          && data().passed is bool
          && data().xp is int && data().xp >= 0 && data().xp <= 100
          && data().day is string
          && data().day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data().at is timestamp
          && data().deviceId is string
          && data().deviceId.matches('^[0-9a-f]{32}$')
          && (data().type == 'missionDone'
                ? !('label' in data()) || data().label == null
                : 'label' in data() && isText(data().label, 40))
          && (!('prob' in data()) || data().prob == null
                || (data().prob is number && data().prob >= 0
                    && data().prob <= 1));
        allow update: if false;
        allow delete: if canWrite(uid);
      }
    }
  }
}
