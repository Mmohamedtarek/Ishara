<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window while the process starts (Android 11 and older): the prototype
         background and the Ishara mark (drawable/launch_background.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind Flutter while it initializes and runs: the same background, so
         nothing flashes white (or light in dark mode) before the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ishara_bg</item>
    </style>
</resources>
